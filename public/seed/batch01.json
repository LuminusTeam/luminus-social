[{"op": "set", "collection": "comments", "doc_id": "p14-c1", "data": {"post": "p14", "author": "kwame-mensah", "text": "Jag hittade tre post-it. Inga namn nämnda.", "tid": "2026-11-01T15:30:00+01:00", "planerad_tid": "2026-11-01T15:30:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"skratta": ["mykel", "rafael-costa", "lucia-ferreira", "tor-ekvall"]}}}, {"op": "set", "collection": "comments", "doc_id": "p15-c1", "data": {"post": "p15", "author": "petra-lind", "text": "Jag testar banorna innan jag kör. Det är mitt jobb.", "tid": "2026-11-01T17:44:00+01:00", "planerad_tid": "2026-11-01T17:44:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"skratta": ["lucia-ferreira", "mykel", "kwame-mensah", "maja-eklof"]}}}, {"op": "set", "collection": "comments", "doc_id": "p16-c1", "data": {"post": "p16", "author": "elin-soderberg", "text": "Fågelholkarna klarade dagen. En talgoxe i nummer fyra i morse.", "tid": "2026-11-01T20:41:00+01:00", "planerad_tid": "2026-11-01T20:41:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"uppskatta": ["erik-johansson", "nils-fredriksson"]}}}, {"op": "set", "collection": "comments", "doc_id": "p16-c2", "data": {"post": "p16", "author": "nils-fredriksson", "text": "Nummer fyra är en av mina. Det värmer.", "tid": "2026-11-01T21:02:00+01:00", "planerad_tid": "2026-11-01T21:02:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"omtanke": ["elin-soderberg"]}}}, {"op": "set", "collection": "comments", "doc_id": "p18-c1", "data": {"post": "p18", "author": "johanna-rehn", "text": "Pollen är redo. Polly tar med pilotplanen.", "tid": "2026-11-02T08:41:00+01:00", "planerad_tid": "2026-11-02T08:41:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p19-c1", "data": {"post": "p19", "author": "amina-diallo", "text": "Jag tar emot det med glädje. Barken har mycket att hålla ordning på.", "tid": "2026-11-02T12:25:00+01:00", "planerad_tid": "2026-11-02T12:25:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"uppskatta": ["bjarke", "eon"]}}}, {"op": "set", "collection": "comments", "doc_id": "p19-c2", "data": {"post": "p19", "author": "maja-eklof", "text": "Myceliets första retro står i kalendern på fredag.", "tid": "2026-11-02T12:33:00+01:00", "planerad_tid": "2026-11-02T12:33:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p21-c1", "data": {"post": "p21", "author": "flora", "text": "Direkt i filerna, tack. Leila samlar ihop dem efter lunch i morgon.", "tid": "2026-11-02T13:52:00+01:00", "planerad_tid": "2026-11-02T13:52:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p21-c2", "data": {"post": "p21", "author": "markus-feldt", "text": "Jag skriver kommentarerna kort. Ingen får känna sig utpekad.", "tid": "2026-11-02T14:05:00+01:00", "planerad_tid": "2026-11-02T14:05:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"uppskatta": ["bjarke", "amina-diallo"]}}}, {"op": "set", "collection": "comments", "doc_id": "p22-c1", "data": {"post": "p22", "author": "linde", "text": "Ja. Mia och Lars tar de första samtalen, Fatima tar dem på engelska.", "tid": "2026-11-02T14:40:00+01:00", "planerad_tid": "2026-11-02T14:40:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"uppskatta": ["polly", "mia-sandberg", "lars-holm", "fatima-nasser"]}}}, {"op": "set", "collection": "comments", "doc_id": "p23-c1", "data": {"post": "p23", "author": "kelda", "text": "Jag har tränat på budgivningen. Var beredd.", "tid": "2026-11-02T15:12:00+01:00", "planerad_tid": "2026-11-02T15:12:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"skratta": ["oskar-lindgren", "anneli-berg"]}}}, {"op": "set", "collection": "comments", "doc_id": "p28-c1", "data": {"post": "p28", "author": "flora", "text": "Blomman har satt formspråket: pergament, bläck och guld, bågramar på porträtten, natt när det mörknar.", "tid": "2026-11-02T15:50:00+01:00", "planerad_tid": "2026-11-02T15:50:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p28-c2", "data": {"post": "p28", "author": "mykel", "text": "Myceliet: inlägg, kommentarer, reaktioner, kalendrar och bildkön ligger i databasen. Allt som skrivs här sparas för alla.", "tid": "2026-11-02T15:52:00+01:00", "planerad_tid": "2026-11-02T15:52:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p28-c3", "data": {"post": "p28", "author": "kelda", "text": "Källan har läst in alla 58 profiler från presentationen, med de nya personliga fälten.", "tid": "2026-11-02T15:53:00+01:00", "planerad_tid": "2026-11-02T15:53:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p28-c4", "data": {"post": "p28", "author": "linde", "text": "Lunden: när någon skriver till en av oss svarar personen själv, i sin egen ton.", "tid": "2026-11-02T15:54:00+01:00", "planerad_tid": "2026-11-02T15:54:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02"}}, {"op": "set", "collection": "comments", "doc_id": "p28-c5", "data": {"post": "p28", "author": "bjarke", "text": "Barken har granskat första versionen. Vi rättade tre saker och stoppade ingenting.", "tid": "2026-11-02T15:55:00+01:00", "planerad_tid": "2026-11-02T15:55:00+01:00", "status": "publicerad", "kalla": "seed-2026-11-02", "reaktioner": {"gilla": ["eon", "amina-diallo"]}}}, {"op": "set", "collection": "photo_requests", "doc_id": "ph-p02", "data": {"vem": ["eon", "astrid-vinter"], "var": "Vreta, Uppsala kommun", "land": "Sverige", "nar": "2026-10-31T11:30:00+01:00", "vader": "torrt och kallt, dygnsmedel 2,8 °C, 0 mm", "ljus": "dagsljus (sol upp 07:07, ned 15