{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/audio/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    },
    {
     "key": "Accept-Ranges",
     "value": "bytes"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "vretasound.com"
    }
   ],
   "destination": "/vreta-sound-system",
   "permanent": false
  },
  {
   "source": "/en",
   "has": [
    {
     "type": "host",
     "value": "vretasound.com"
    }
   ],
   "destination": "/vreta-sound-system/en",
   "permanent": false
  },
  {
   "source": "/mixer",
   "has": [
    {
     "type": "host",
     "value": "vretasound.com"
    }
   ],
   "destination": "/vreta-sound-system/mixer",
   "permanent": false
  },
  {
   "source": "/en/mixer",
   "has": [
    {
     "type": "host",
     "value": "vretasound.com"
    }
   ],
   "destination": "/vreta-sound-system/en/mixer",
   "permanent": false
  },
  {
   "source": "/(.*)",
   "has": [
    {
     "type": "host",
     "value": "www.vretasound.com"
    }
   ],
   "destination": "https://vretasound.com/$1",
   "permanent": false
  }
 ]
}