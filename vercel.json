{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/audio/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    },
    {
     "key": "Accept-Ranges",
     "value": "bytes"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "vretasound.com"
    }
   ],
   "destination": "/vreta-sound-system/index.html"
  },
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "www.vretasound.com"
    }
   ],
   "destination": "/vreta-sound-system/index.html"
  }
 ]
}
